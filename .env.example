# ═══════════════════════════════════════════════════════════════
# EduMonitor (College Monitoring System) — Environment Variables
# Copy this file to .env and fill in your actual values:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env
# ⚠️ DO NOT commit your .env file with real secrets to GitHub!
# ═══════════════════════════════════════════════════════════════

# ── Django Core Settings ──────────────────────────────────────
DJANGO_SECRET_KEY=django-insecure-change-this-to-a-strong-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Firebase Configuration (Optional for local testing) ───────
# Note: If left blank or unconfigured, the app will automatically
# run with a zero-config local JSON database (firebase_local.json).
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_PROJECT_ID=your-firebase-project-id
